@model IEnumerable<Gathered_News.Models.ArticleModel>

<div class="container py-4">
    <h1 class="mb-4">Latest Articles</h1>

    <div class="row g-4">
        @foreach (var article in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@article.Title</h5>
                        <p class="text-muted small mb-2">@article.Source</p>
                        @if (!string.IsNullOrWhiteSpace(article.Url))
                        {
                            <a href="@article.Url" target="_blank" class="btn btn-primary btn-sm">Read article</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>